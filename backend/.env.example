# Mike backend environment variables.
#
# Copy this file to `.env` in the same directory (`backend/.env`) and fill in
# real values. Never commit `.env` — it is already excluded by .gitignore.
#
# Legend used below:
#   [required]     the server calls `process.exit(1)` at boot if this is missing
#                   (see backend/src/lib/env.ts)
#   [recommended]   the server still starts, but the related feature is disabled
#                   until it is set
#   [optional]      safe to leave unset
#   (local)         only needed for local development
#   (vercel n/a)    this backend does not run on Vercel; set this wherever you
#                   actually host it (Railway, Render, Fly, a VM, etc.) — see
#                   README.md "Vercel deployment" section for why.

# -----------------------------------------------------------------------------
# App / networking
# -----------------------------------------------------------------------------

# [optional] Port the Express server listens on.
PORT=3001

# [required in practice] Origin allowed by CORS for browser requests, and the
# value the app assumes when building links back to the frontend.
# (local) http://localhost:3000
# In a deployed test: your Vercel frontend URL, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Postgres + Auth) — see SUPABASE_SETUP.md for how to get these
# -----------------------------------------------------------------------------

# [required] Project URL, from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co

# [required] SERVICE ROLE key (not the anon key). Bypasses Row Level Security —
# treat this like a database superuser password. Never expose it to a browser
# or commit it. From Supabase Dashboard > Project Settings > API.
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Object storage — S3-compatible (Cloudflare R2 by default; MinIO or any other
# S3-compatible provider also works by pointing R2_ENDPOINT_URL at it)
# -----------------------------------------------------------------------------

# [recommended] Without these, uploads/downloads/document generation are
# disabled but the rest of the app still runs (storageEnabled=false).
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

# -----------------------------------------------------------------------------
# LLM providers — set at least one for instance-wide model access. Users can
# alternatively add their own personal key in Account > Models & API Keys
# without any of these being set.
# -----------------------------------------------------------------------------

# [optional, but at least one provider key is needed for the assistant to work
# without per-user keys]
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# -----------------------------------------------------------------------------
# Security secrets
# -----------------------------------------------------------------------------

# [recommended] HMAC key used to sign /download/:token URLs for generated
# documents. Falls back to SUPABASE_SECRET_KEY if unset, but a dedicated
# secret is safer. Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string

# [recommended] Encrypts per-user model provider API keys at rest in
# `public.user_api_keys`. Generate with: openssl rand -hex 32
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret

# -----------------------------------------------------------------------------
# Email (optional — no code currently sends email through this key; reserved
# for a future transactional-email feature. Safe to leave unset.)
# -----------------------------------------------------------------------------

RESEND_API_KEY=your-resend-key

# -----------------------------------------------------------------------------
# Rate limiting (optional — sane defaults are baked in; override only if you
# need different limits for load testing or a higher-traffic deployment)
# -----------------------------------------------------------------------------

# RATE_LIMIT_GENERAL_WINDOW_MINUTES=15
# RATE_LIMIT_GENERAL_MAX=300
# RATE_LIMIT_CHAT_WINDOW_MINUTES=15
# RATE_LIMIT_CHAT_MAX=30
# RATE_LIMIT_CHAT_CREATE_WINDOW_MINUTES=15
# RATE_LIMIT_CHAT_CREATE_MAX=60
# RATE_LIMIT_UPLOAD_WINDOW_HOURS=1
# RATE_LIMIT_UPLOAD_MAX=50
# TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Mode.law / deployment-profile future-proofing (optional)
# -----------------------------------------------------------------------------

# [optional] Selects a branding/config profile from backend/src/config. Only
# "oss" exists today; this is a placeholder for a future "mode-law" profile.
# See config/README.md for the full explanation.
# DEPLOYMENT_PROFILE=oss
