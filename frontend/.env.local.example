# Mike frontend environment variables.
#
# Copy this file to `.env.local` in the same directory (`frontend/.env.local`)
# and fill in real values. Never commit `.env.local` — it is already excluded
# by .gitignore.
#
# IMPORTANT: anything prefixed `NEXT_PUBLIC_` is bundled into client-side
# JavaScript and is visible to anyone using the app. Only put values here that
# are safe to expose in a browser. The one exception below
# (`SUPABASE_SECRET_KEY`) is intentionally NOT prefixed `NEXT_PUBLIC_` — see
# its comment.

# -----------------------------------------------------------------------------
# Supabase (Auth) — see SUPABASE_SETUP.md for how to get these
# -----------------------------------------------------------------------------

# [required] Project URL, from Supabase Dashboard > Project Settings > API.
# Safe to expose — this is a public endpoint, not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [required] The anon/public key, from Supabase Dashboard > Project Settings >
# API. Safe to expose — Row Level Security is what actually protects data,
# not secrecy of this key. If your Supabase project shows multiple key
# formats, use the legacy JWT-style anon key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key

# [required, server-side only] Service role key. NOT prefixed NEXT_PUBLIC_ on
# purpose — Next.js only exposes NEXT_PUBLIC_ vars to the browser, so this
# stays server-side. Currently unused by any active code path in the
# frontend app (see SETUP_AUDIT.md "known gaps"), but kept here because a
# couple of legacy/dead server-only files reference it. Use the same service
# role value as backend/.env if you set it.
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------

# [required] Base URL of the Express backend (see backend/.env.example).
# (local) http://localhost:3001
# Vercel preview/production: the public URL of wherever you host the backend
# (Railway/Render/Fly/a VM). The Express backend does not run on Vercel — see
# README.md "Vercel deployment" for why and what the least-invasive path is.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Mode.law / deployment-profile future-proofing (optional)
# -----------------------------------------------------------------------------

# [optional] Selects a branding/config profile from frontend/src/config. Only
# "oss" exists today; this is a placeholder for a future "mode-law" profile.
# Prefixed NEXT_PUBLIC_ because branding (name, links, feature flags) is
# inherently client-visible. See config/README.md for the full explanation.
# NEXT_PUBLIC_DEPLOYMENT_PROFILE=oss
